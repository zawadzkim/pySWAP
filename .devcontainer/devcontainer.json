// Development container for pySWAP, used by GitHub Codespaces
// (https://codespaces.new/zawadzkim/pySWAP). The environment is the pixi `dev`
// environment of the repository, which includes Jupyter, so the tutorials in
// docs/tutorials/notebooks run as they are.
// Format: https://aka.ms/devcontainer.json
{
  "name": "pyswap",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  // Installs pixi and the dev environment, fetches the crop-parameter
  // submodule and registers the Jupyter kernel.
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["docs/tutorials/README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "editorconfig.editorconfig",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.rulers": [88],
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.pixi/envs/dev/bin/python",
        "python.testing.pytestArgs": ["tests"],
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true
      }
    }
  }
}
